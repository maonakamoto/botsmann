{
  "name": "botsmann",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "pnpm install --frozen-lockfile && pnpm run build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:watch": "vitest run --watch",
    "test:db": "tsx scripts/test-db-connection.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:selfhost": "bash scripts/ci/no-hosted-supabase.sh",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:selfhost && pnpm run test && pnpm run build",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@bitbaum/ai-kit": "^0.11.0",
    "@bitbaum/mail-kit": "^0.1.0",
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@xenova/transformers": "^2.17.2",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-icons": "^5.7.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.4.1",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.25.0"
}
